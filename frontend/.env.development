# Auto-loaded by CRA for `npm start` (development mode only — has no
# effect on `npm run build`/the Docker image, which reads
# FRONTEND_INSTANCE_NAME from docker-compose.yml's build args instead).
# Not a secret, safe to commit — just a label under the brand so it's
# obvious at a glance this is the dev server, not a real deployment.
REACT_APP_FRONTEND_INSTANCE_NAME=Development
