# Created by https://www.toptal.com/developers/gitignore/api/rust
# Edit at https://www.toptal.com/developers/gitignore?templates=rust

### Rust ###
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is committed, not ignored: magnolia-server is a binary
# (crates/api's [[bin]]), and the root Dockerfile's cargo-chef build depends
# on it being present in a fresh checkout (COPY Cargo.toml Cargo.lock ./) —
# see https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# End of https://www.toptal.com/developers/gitignore/api/rust

# Local secrets for docker-compose (e.g. DTRACK_API_KEY, written by
# scripts/bootstrap-dtrack.sh) — never committed.
.env
aidex


# Dependency-Track API key copied out of the dtrack_key volume for native `cargo run`
.dtrack-dev-key
# Local signing key and SBOM storage created by a native `cargo run`
.sbomstash_key
.dev-data/

# Demo source repository built by scripts/demo-repo.sh from demo/shop-api
demo/.repos/

# macOS Finder metadata, Python bytecode, and the local AiDex code index
.DS_Store
__pycache__/
*.pyc
.aidex/
