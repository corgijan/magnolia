# reach — configuration. Env vars only: swapping the inference server or the
# model must never require a code change. Copy to `.env` (git-ignored) and
# edit; every value below is the built-in default unless marked otherwise.

# ---- service -------------------------------------------------------------
REACH_SERVER_ADDR=127.0.0.1:3100
REACH_DB_PATH=reach.db

# Single static bearer token for the whole API. UNSET MEANS UNAUTHENTICATED —
# acceptable for a local run against fixture repositories, never for anything
# another machine can reach. Generate one with:
#   openssl rand -base64 32
REACH_API_TOKEN=

# ---- inference (OpenAI-compatible /v1/chat/completions) -------------------
# Development: a hosted OpenAI-compatible endpoint.
#   REACH_AI_BASE_URL=https://api.example.com
#   REACH_AI_MODEL=some-hosted-model
#   REACH_AI_API_KEY=sk-...
#
# Submission: a locally hosted model. Ollama serves an OpenAI-compatible API
# at /v1 and needs no key.
REACH_AI_BASE_URL=http://localhost:11434
REACH_AI_MODEL=gemma3:4b
REACH_AI_API_KEY=
# Generous by default: an 8B model on CPU can take minutes for one call, and
# a timeout that fires mid-generation looks exactly like an outage.
REACH_AI_TIMEOUT_SECS=60
# Reasoning models (deepseek-r1, Qwen3.6 and similar) spend most of this
# budget on hidden chain-of-thought before the JSON starts; raise it to
# 6000+ for those, or every answer arrives with content entirely missing
# (reach reports this specifically as "truncated_during_reasoning", not a
# generic empty response).
REACH_AI_MAX_TOKENS=1024
# Also worth double-checking against your provider's docs before anything
# else: REACH_AI_BASE_URL is the exact base a real request is built from
# (this file joins it with /v1/chat/completions) — a provider whose actual
# API lives one path segment deeper (e.g. https://host/api/v1/... rather
# than https://host/v1/...) will otherwise silently hit an unrelated route
# on that host instead of erroring, which is much harder to diagnose.
# 0 keeps eval runs reproducible: the same advisory yields the same ruleset,
# so the metrics measure the prompt rather than sampling noise.
REACH_AI_TEMPERATURE=0

# ---- repository fetching -------------------------------------------------
REACH_CACHE_DIR=./.reach-cache
REACH_CACHE_MB=2048
# Token for private repositories. Passed to git via GIT_CONFIG_* env vars —
# never on the command line, never inside a URL.
REACH_GIT_TOKEN=

# ---- caps (all bound work done on attacker-influenceable input) ----------
REACH_MAX_REPO_MB=512
REACH_MAX_SITES=50
# Each scored site is one inference call, so this is the main latency knob.
REACH_MAX_SCORED_SITES=5
REACH_MAX_FILE_KB=512
REACH_MAX_ADVISORY_CHARS=12000

# ---- test mode -----------------------------------------------------------
# Canned `direct_references` report for every analysis, no inference check at
# startup. For exercising the UI without a model only — see README "Test mode".
REACH_TEST_MODE=
