# Copy this file to `.env` (git-ignored) before deploying anywhere other
# than local dev on your own machine. `docker compose` reads `.env`
# automatically from the same directory as the compose file — nothing else
# to wire up.
#
# Every one of these has an insecure default baked into docker-compose.yml
# so a plain `docker compose up` still works with zero setup for local
# dev/testing. Those defaults are publicly documented in this repo's own
# README and git history — leaving them unset on an internet-reachable host
# hands out super_admin access (and DB access, if you ever add a `ports:`
# mapping back) to anyone who finds this repo.

# --- Required before any internet-facing deployment ------------------------

# The bootstrap super_admin key, in the form `mag_<43 base64url chars>`.
# Generate one (prints the key plus the columns it maps to):
#   cargo run -p magnolia-auth --example bootstrap_key
# This is the ONLY way to get a first usable key into a fresh deployment —
# after that, every other tenant/key is self-service through the API/UI.
# There is deliberately NO default: unset means no bootstrap key is created
# at all (fail closed), because a built-in fallback would be a
# publicly-known super_admin credential for anyone who reads this repo.
# Paste the value you generate into the UI once, then treat it like any
# other admin credential (a password manager, not a note).
BOOTSTRAP_SUPER_ADMIN_KEY=

# Postgres password for Magnolia's own database (the `db` service).
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=

# Must be "false" (or unset) on any host reachable from the internet — it
# relaxes an RBAC check (see docker-compose.yml's own comment). Only set to
# "true" in a local-only .env if you want that relaxed behavior for dev.
DEV_MODE=false

# --- Only needed if you also enable Dependency-Track integration -----------
# (docker compose -f docker-compose.yml -f docker-compose.dtrack.yml up -d,
# or docker compose --profile dtrack up -d) — see README's "Optional:
# Dependency-Track integration".

# Postgres password for dtrack's own database (the `dtrack-db` service).
# Generate one: openssl rand -hex 24
DTRACK_DB_PASSWORD=

# dtrack forces an admin password change on first boot; the bootstrap
# script/container performs that change for you using this value.
# Generate one: openssl rand -hex 16
DTRACK_ADMIN_PASSWORD=

# --- Optional web UI (docker compose --profile frontend up) ----------------
# Most local dev runs the frontend natively instead (`cd frontend && npm
# start`) — this container is for actually serving the built assets
# yourself rather than from a CDN/static host. See README.

# FRONTEND_PORT=4000

# Small label shown under the "Magnolia" brand in the UI (top left) —
# useful for telling deployments apart at a glance, e.g. "Development",
# "Staging", "acme-corp.example". Baked in at image build time (CRA doesn't
# read env vars at container runtime) — changing this needs
# `docker compose build frontend`, not just a restart. Empty by default;
# nothing renders unless it's set.
# FRONTEND_INSTANCE_NAME=

# --- Optional, cosmetic/tuning — safe to leave unset -----------------------

# API_PORT=3000
# BOOTSTRAP_TENANT_DOMAIN=platform.example
# BOOTSTRAP_TENANT_NAME=Platform
# DTRACK_SYNC_INTERVAL_SECS=600
